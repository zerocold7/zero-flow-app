# Normalize line endings: text files are stored as LF in the repo.
# Windows-only script formats stay CRLF on checkout.
* text=auto
*.bat  text eol=crlf
*.vbs  text eol=crlf

# Binary assets — never apply line-ending/text conversion
# (so they are never CRLF-mangled and never shown as text diffs).
*.pdf  binary
*.docx binary
*.ico  binary
*.jpg  binary
*.jpeg binary
*.png  binary
*.wav  binary
