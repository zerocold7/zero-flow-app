# Your files from before 2.0.0-alpha.5, left in the program folder by the move to
# %APPDATA%\ZeroFlow (they are never read again, but must never be committed)
flow_vocabulary.txt*
flow_history.md
flow_debug.log*
reader_debug.log*
builtin_ai.log*
*_crash.log

# Python cache and test coverage
.coverage
htmlcov/
__pycache__/
*.py[cod]
*$py.class

# Environment files
venv/
env/
python_env/
.env
.env.bak

# Speech benchmark clips and results (regenerated by tools/bench/make_clips.py)
tools/bench/clips/
tools/bench/mine/
tools/bench/results/

# The built-in AI runtime (tools/get_llama.py)
runtime/

# Left behind only if tools/mutation_check.py is killed mid-run
*.mutbak

# PyInstaller builds (packaging/zeroflow.spec)
build/
dist/
venv-cpu/
# Generated per edition by tools/licence_audit.py
THIRD-PARTY-NOTICES.txt
