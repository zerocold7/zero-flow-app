# Zero- Flow preset — NVIDIA graphics card with 8 GB or more (desktop RTX 3060 12 GB,
# 3070, 4060 Ti, 4070 and up).
#
# Apply it:  python check_hardware.py --apply        (merges into your .env)
#   or copy this file to .env — anything not listed here keeps its normal default.
#
# Graphics memory, measured on an RTX 4070 (12 GB): Whisper large-v3 3.9 GB in float16,
# the Kokoro voice 1.1 GB, qwen2.5:7b about 5.5 GB — about 10.5 GB together.
# On an 8-10 GB card use WHISPER_COMPUTE_TYPE="int8_float16" (large-v3 drops to 2.0 GB);
# check_hardware.py does that for you.

WHISPER_MODEL_NAME="large-v3"     # best accuracy, and the best Arabic
WHISPER_DEVICE="auto"             # GPU, falling back to the CPU if CUDA fails
WHISPER_COMPUTE_TYPE="float16"    # int8_float16 on 8-10 GB cards
OLLAMA_MODEL_NAME="qwen2.5:7b"    # run `ollama pull qwen2.5:7b` first
READER_DEVICE="auto"              # the voice on the GPU (~70x real time)
