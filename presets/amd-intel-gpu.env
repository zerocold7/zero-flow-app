# Zero- Flow preset — a dedicated AMD Radeon (RX 6000/7000/9000) or Intel Arc
# (A380-A770, B580) graphics card.
#
# Apply it:  python check_hardware.py --apply        (merges into your .env)
#   or copy this file to .env — anything not listed here keeps its normal default.
#
# The speech engine (CTranslate2) and the voice (PyTorch) only use NVIDIA cards on
# Windows, so both run on the CPU here — the same as cpu-only.env. The built-in AI can
# use your card through llama.cpp's Vulkan build (not yet tried on one: if Polish
# fails, set LLAMA_VARIANT="cpu" and run tools/get_llama.py --variant cpu).

WHISPER_MODEL_NAME="small"        # speech runs on the CPU
WHISPER_DEVICE="cpu"              # skip the NVIDIA attempt
READER_DEVICE="cpu"               # the voice runs on the CPU
AI_PROVIDER="builtin"             # the AI runs inside the engine (no Ollama)
LLAMA_VARIANT="vulkan"            # llama.cpp for AMD Radeon / Intel Arc cards
