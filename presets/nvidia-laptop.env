# Zero- Flow preset — NVIDIA graphics with 4-7 GB (most gaming laptops: RTX 3050,
# 3060 laptop 6 GB, 4050, 4060 laptop 8 GB also fits here if the desktop preset is
# too tight).
#
# Apply it:  python check_hardware.py --apply        (merges into your .env)
#   or copy this file to .env — anything not listed here keeps its normal default.
#
# Graphics memory, estimated from the large-v3 measurement (2.0 GB in int8_float16):
# medium about 1 GB, small about 0.4 GB; the Kokoro voice 1.1 GB; the built-in AI
# (Gemma 4 E4B) 3.2 GB. On a 4-5 GB card use "small" and the smaller Gemma 4 E2B —
# check_hardware.py does that for you.

WHISPER_MODEL_NAME="medium"          # "small" on 4-5 GB cards
WHISPER_DEVICE="auto"                # GPU, falling back to the CPU if CUDA fails
WHISPER_COMPUTE_TYPE="int8_float16"  # half the graphics memory of float16
READER_DEVICE="auto"                 # the voice on the GPU
AI_PROVIDER="builtin"                # the AI runs inside the engine (no Ollama)
LLAMA_VARIANT="cuda"                 # llama.cpp for NVIDIA cards (tools/get_llama.py installs it)
