# Local Voice Flow Configuration
# Copy this file to .env and edit it; restart the engine after any change.

# --- Core AI Settings ---
# Not sure what suits your PC? Run:  python check_hardware.py --apply
# (presets/ holds a ready-made set of these values per kind of hardware.)
WHISPER_MODEL_NAME="large-v3"     # models download once from Hugging Face, then load from the
                                 # local cache with no network call (no HF_TOKEN needed)
WHISPER_DEVICE="auto"             # auto = NVIDIA GPU, falling back to CPU | cpu = skip the GPU
WHISPER_COMPUTE_TYPE="float16"    # GPU precision; int8_float16 halves graphics memory
OLLAMA_HOST_URL="http://127.0.0.1:11434/api/generate"
OLLAMA_MODEL_NAME=""             # pin an exact Ollama model, e.g. "qwen2.5:7b" (blank = auto-pick first served)
FALLBACK_LLM="gemma2:27b"        # used only if Ollama is unreachable
OLLAMA_KEEP_ALIVE="30m"          # how long the AI model stays loaded after use; "0" = unload at once
SAMPLE_RATE=16000
CHANNELS=1

# --- Recording mode keybindings (each FORCES its language) ---
HOTKEY_EN_RAW="f5"          # English, raw
HOTKEY_EN_POLISH="f6"       # English, AI cleanup
HOTKEY_AR_RAW="f7"          # Arabic, raw
HOTKEY_AR_POLISH="f8"       # Arabic, AI cleanup
HOTKEY_EN2AR="f9"           # Translate English -> Arabic
HOTKEY_AR2EN="f10"          # Translate Arabic -> English

# --- Action keybindings ---
HOTKEY_FIX="shift+f3"          # fix the current line
HOTKEY_MAINTENANCE="shift+f1"  # vocabulary maintenance
HOTKEY_PURGE="shift+f2"        # clear debug log & history
HOTKEY_PANIC="esc"             # cancel the current recording / silence the reader

# --- Reader: text -> speech (Launch_Zero.bat, or Launch_Reader.bat on its own) ---
HOTKEY_READ="f4"            # read the highlighted text aloud
                            # (HOTKEY_PANIC above silences the reader too)
READER_VOICE="af_heart"     # af_heart | af_bella | bf_emma (also in the tray menu)
READER_SMART_MODE="False"   # True = clean captured text with the LLM before speaking
READER_SMART_MAX_CHARS=1000 # selections longer than this skip the LLM pass
READER_LLM_TIMEOUT=10       # seconds to wait for the LLM before speaking anyway
READER_FIRST_BATCH_CHARS=120  # first batch sent to the voice model (smaller = speech
                              # starts sooner). Only worth touching on CPU.
READER_BATCH_CHARS=300        # every batch after the first
READER_DEVICE="auto"        # auto | cpu | cuda for the voice model. Honoured by
                            # every launcher: the reader always runs in its own
                            # process, so it never fights Whisper for CUDA.

# --- Quality of Life ---
ENABLE_AUDIO_CHIMES="True"
ENABLE_TOAST_NOTIFICATIONS="True"