# Zero- Flow Engine: optional one-time import template
# Your settings live in %APPDATA%\ZeroFlow\settings.json; edit that file (restart the
# engine after any change). This file is only a starting point for the FIRST start: if
# you copy it to .env in the program folder before you start the engine for the first
# time, the engine reads it once, writes settings.json from it, and never reads .env
# again. (Without a .env, the first start uses the defaults.) See CONFIGURATION.md section 1.

# --- Core AI Settings ---
# Not sure what suits your PC? Run:  python check_hardware.py --apply
# (presets/ holds a ready-made set of these values per kind of hardware.)
WHISPER_MODEL_NAME="large-v3"     # models download once from Hugging Face, then load from the
                                 # local cache with no network call (no HF_TOKEN needed)
WHISPER_DEVICE="auto"             # auto = NVIDIA GPU, falling back to CPU | cpu = skip the GPU
WHISPER_COMPUTE_TYPE="float16"    # GPU precision; int8_float16 halves graphics memory
AI_LOAD_AT_START="True"           # False = the AI loads on the first Polish, not at start (tray: "Unload AI model" frees it)
AI_PROVIDER="builtin"             # builtin (no Ollama needed; tools/get_llama.py), ollama, openai or claude (CONFIGURATION.md section 6)
LLAMA_VARIANT="auto"              # the built-in AI's build: auto, cuda (NVIDIA), vulkan (AMD/Intel card), cpu
AI_BUILTIN_REPO="google/gemma-4-E4B-it-qat-q4_0-gguf"
AI_BUILTIN_FILE="gemma-4-E4B_q4_0-it.gguf"   # Gemma 4 E2B (gemma-4-E2B_q4_0-it.gguf, google/gemma-4-E2B-it-qat-q4_0-gguf) is smaller
AI_URL=""                         # openai: the server's chat/completions address
AI_MODEL=""                       # openai/claude: the model (claude: blank = claude-opus-5-5)
AI_API_KEY=""                     # openai/claude: your API key. The first start moves it into Windows
                                 # Credential Manager (it is never kept in settings.json)
POLISH_CLIPBOARD_CONTEXT="auto"   # clipboard as Polish context: auto (AI on this PC only) | on | off
OLLAMA_HOST_URL="http://127.0.0.1:11434/api/generate"
OLLAMA_MODEL_NAME=""             # pin an exact Ollama model, e.g. "qwen2.5:7b" (blank = auto-pick first served)
OLLAMA_KEEP_ALIVE="30m"          # how long the AI model stays loaded after use; "0" = unload at once
MAX_RECORDING_SECONDS=300        # a recording left running stops (and is transcribed) after this

# --- Recording mode keybindings (each FORCES its language) ---
HOTKEY_EN_RAW="f5"          # English, raw
HOTKEY_EN_POLISH="f6"       # English, AI cleanup
HOTKEY_AR_RAW="f7"          # Arabic, raw
HOTKEY_AR_POLISH="f8"       # Arabic, AI cleanup
HOTKEY_EN2AR="f9"           # Translate English -> Arabic
HOTKEY_AR2EN="f10"          # Translate Arabic -> English

# --- Action keybindings ---
HOTKEY_FIX="shift+f3"          # fix the current line
HOTKEY_MAINTENANCE="shift+f1"  # vocabulary maintenance
HOTKEY_PURGE="shift+f2"        # clear debug log & history

# --- Reader: text -> speech (Launch_Zero.bat, or Launch_Reader.bat on its own) ---
HOTKEY_READ="f4"            # read the highlighted text aloud
                            # (Esc silences the reader too, and cancels a recording)
READER_VOICE="af_heart"     # af_heart | af_bella | bf_emma (also in the tray menu)
READER_SMART_MODE="False"   # True = clean captured text with the LLM before speaking
READER_DEVICE="auto"        # auto | cpu | cuda for the voice model. Honoured by
                            # every launcher: the reader always runs in its own
                            # process, so it never fights Whisper for CUDA.

# --- Quality of Life ---
ENABLE_AUDIO_CHIMES="True"
ENABLE_TOAST_NOTIFICATIONS="True"
LOG_DICTATION_TEXT="False"       # True writes what you dictate into flow_debug.log (debugging only;
                                 # the logs are in %LOCALAPPDATA%\ZeroFlow\logs)